{
    "name": "tainacan/tainacan",
    "description": "Transforme seu site wordpress em um repositório digital.",
    "type": "wordpress-plugin",
    "require": {
        "respect/validation": "^1.1",
        "smalot/pdfparser": "*",
        "kornrunner/blurhash": "^1.1",
        "symfony/polyfill-mbstring": "1.20.0",
        "phpcompatibility/php-compatibility": "*",
        "phpoffice/phpspreadsheet": "^5.0"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0.0",
        "wp-coding-standards/wpcs": "^3.1.0",
        "squizlabs/php_codesniffer": "^3.10.0",
        "yoast/phpunit-polyfills": "^1.1.0",
        "pronamic/wp-documentor": "^1.4",
        "saggre/phpdocumentor-markdown": "^1.0.0",
        "smeghead/php-class-diagram": "^1.3"
    },
    "prefer-stable" : true,
    "minimum-stability": "dev",
    "config": {
        "vendor-dir": "src/vendor",
        "platform-check": false,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "phpcs": "\"src/vendor/bin/phpcs\"",
        "phpcbf": "\"src/vendor/bin/phpcbf\""
    }
}
